;;; core-ui.el --- 基础 UI 设置 -*- lexical-binding: t -*-
;;; Commentary:

;; 基础界面配置：禁用工具栏、菜单栏、滚动条，设置铃声等。
;; 不依赖任何第三方包，仅使用 Emacs 内置功能。

;;; Code:

;; ============================================================================
;; 平台检测
;; ============================================================================

(defconst skemacs-is-mac (eq system-type 'darwin)
  "当前是否运行在 macOS 上。")

(defconst skemacs-is-linux (eq system-type 'gnu/linux)
  "当前是否运行在 Linux 上。")

(defconst skemacs-is-windows (eq system-type 'windows-nt)
  "当前是否运行在 Windows 上。")

;; ============================================================================
;; 启动界面
;; ============================================================================

;; 禁用启动欢迎界面
(setq inhibit-startup-message t)

;; 在关闭 Emacs 前询问确认，防止误触
(setq confirm-kill-emacs #'yes-or-no-p)

;; ============================================================================
;; 工具栏 / 菜单栏 / 滚动条
;; ============================================================================

;; 关闭工具栏（终端模式下该函数不存在）
(when (fboundp 'tool-bar-mode)
  (tool-bar-mode -1))

;; 隐藏菜单栏
(menu-bar-mode -1)

;; 图形界面时关闭滚动条
(when (display-graphic-p)
  (when (fboundp 'scroll-bar-mode)
    (scroll-bar-mode -1)))

;; ============================================================================
;; 模式行（Mode Line）
;; ============================================================================

;; 在 mode-line 中显示列号
(column-number-mode t)

;; ============================================================================
;; 滚动
;; ============================================================================

;; 光标移出窗口时逐行滚动，而非跳半页重新居中
(setq scroll-conservatively 101)

;; 光标距离窗口边缘还有 5 行时就开始滚动，避免贴边
(setq scroll-margin 5)

;; 平滑像素滚动（Emacs 29+）
(when (fboundp 'pixel-scroll-precision-mode)
  (pixel-scroll-precision-mode t))

;; ============================================================================
;; 铃声
;; ============================================================================

;; 静音铃声
(setq visible-bell nil)
(setq ring-bell-function 'ignore)

(provide 'core-ui)
;;; core-ui.el ends here
